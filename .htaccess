DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Non-public files in the repo (docs, tooling, data, audits) → 404.
  RewriteRule ^(docs|tools|data|audit-shots|node_modules)(/|$) - [R=404,L]
  RewriteRule \.(md|json|mjs|example)$ - [R=404,L]
  RewriteRule (^|/)package(-lock)?\.json$ - [R=404,L]
  RewriteRule (^|/)\.(?!well-known/) - [R=404,L]

  # www → apex (one hop, straight to https).
  RewriteCond %{HTTP_HOST} ^www\.carpinteria\.com\.py$ [NC]
  RewriteRule ^ https://carpinteria.com.py%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /index.html and /<slug>/index.html → /<slug>/ (only on the client's
  # request, not on the internal DirectoryIndex lookup).
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?]
  RewriteRule ^(.*/)?index\.html$ https://carpinteria.com.py/$1 [L,R=301]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
